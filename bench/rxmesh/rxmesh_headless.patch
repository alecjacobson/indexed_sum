+// Minimal timing harness for the mass-spring "Diff" quantity (gradient + Hessian
+// assembly = problem.eval_terms()), isolated from the linear solver / line search.
+//
+// This measures *exactly* the quantity RXMesh's MassSpring app reports as the "Diff"
+// timer and that the RXMesh AD paper's Table 1 reports (per-evaluation grad+Hessian
+// assembly, excluding the solve). Isolating it lets us scale to 1M-vertex grids without
+// paying the (Table-1-excluded, here CPU-fallback) direct-solver cost. The energy terms
+// and constants are identical to apps/MassSpring/mass_spring.cu (Flag scene).
+#include <CLI/CLI.hpp>
+
+#include "rxmesh/rxmesh_static.h"
+#include "rxmesh/geometry_factory.h"
+#include "rxmesh/diff/diff_scalar_problem.h"
+#include "rxmesh/util/log.h"
+
+#include "gravity_energy.h"
+#include "inertial_energy.h"
+#include "mass_spring_energy.h"
+
+using namespace rxmesh;
+
+template <typename T>
+void bench_diff(RXMeshStatic& rx, int num_eval, int warmup)
+{
+    RXMESH_INFO("#Faces: {}, #Vertices: {}", rx.get_num_faces(),
+                rx.get_num_vertices());
+
+    constexpr int      VariableDim  = 3;
+    constexpr uint32_t blockThreads = 256;
+    using ProblemT = DiffScalarProblem<T, VariableDim, VertexHandle, true>;
+
+    const T rho = 100;    // density
+    const T k   = 4e4;    // stiffness
+    const T h   = 0.01;   // time step
+
+    glm::vec3 bb_lower(0), bb_upper(0);
+    rx.bounding_box(bb_lower, bb_upper);
+    glm::vec3 bb = bb_upper - bb_lower;
+
+    T mass = 1;
+    if (bb[2] < 1e-5) {
+        mass = rho * bb[0] * bb[1] / rx.get_num_vertices();
+    } else if (bb[1] < 1e-5) {
+        mass = rho * bb[2] * bb[0] / rx.get_num_vertices();
+    } else if (bb[0] < 1e-5) {
+        mass = rho * bb[1] * bb[2] / rx.get_num_vertices();
+    }
+
+    ProblemT problem(rx, true);
+
+    auto rest_l = *rx.add_edge_attribute<T>("RestLen", 1);
+    auto x      = *rx.get_input_vertex_coordinates();
+    auto& x_tilde = *problem.opt_var;
+    x_tilde.copy_from(x, DEVICE, DEVICE);
+
+    // rest length = squared edge length (matches mass_spring.cu)
+    rx.for_each<Op::EV, blockThreads>(
+        [=] __device__(const EdgeHandle& eh, const VertexIterator& iter) {
+            Eigen::Vector3<T> a = x.to_eigen<3>(iter[0]);
+            Eigen::Vector3<T> b = x.to_eigen<3>(iter[1]);
+            rest_l(eh)          = (a - b).squaredNorm();
+        });
+
+    // identical energy terms
+    inertial_energy(problem, x, mass);
+    mass_spring_energy(problem, rest_l, h, k);
+    gravity_energy(problem, x, h, mass);
+
+    // warmup
+    for (int i = 0; i < warmup; ++i) {
+        problem.eval_terms();
+    }
+    cudaDeviceSynchronize();
+
+    // timed loop: total device time over num_eval eval_terms() calls
+    GPUTimer timer;
+    timer.start();
+    for (int i = 0; i < num_eval; ++i) {
+        problem.eval_terms();
+    }
+    timer.stop();
+    cudaDeviceSynchronize();
+
+    const float total_ms = timer.elapsed_millis();
+    RXMESH_INFO("DiffBench: #V= {}, #E= {}, #F= {}, num_eval= {}, total= {} (ms), "
+                "Diff/eval= {} (ms)",
+                rx.get_num_vertices(),
+                rx.get_num_edges(),
+                rx.get_num_faces(),
+                num_eval,
+                total_ms,
+                total_ms / float(num_eval));
+}
+
+int main(int argc, char** argv)
+{
+    using T = float;
+    CLI::App app{"MassSpringDiff - time grad+Hessian assembly (eval_terms) only"};
+
+    int      n         = 16;
+    int      num_eval  = 50;
+    int      warmup    = 10;
+    uint32_t device_id = 0;
+    app.add_option("-n,--grid_size", n, "Grid size (vertices = n*n)")->default_val(16);
+    app.add_option("-e,--num_eval", num_eval, "Number of timed eval_terms calls")
+        ->default_val(50);
+    app.add_option("-w,--warmup", warmup, "Warmup eval_terms calls")->default_val(10);
+    app.add_option("-d,--device_id", device_id, "GPU device ID")->default_val(0u);
+    try {
+        app.parse(argc, argv);
+    } catch (const CLI::ParseError& e) {
+        return app.exit(e);
+    }
+
+    rx_init(device_id);
+    RXMESH_INFO("grid_size= {}, num_eval= {}, warmup= {}", n, num_eval, warmup);
+
+    std::vector<std::vector<T>>        verts;
+    std::vector<std::vector<uint32_t>> fv;
+    T                                  dx = 1 / T(n - 1);
+    create_plane(verts, fv, n, n, 2, dx, false, vec3<float>(0, 0, 0));
+    RXMeshStatic rx(fv);
+    rx.add_vertex_coordinates(verts, "Coords");
+    bench_diff<T>(rx, num_eval, warmup);
+    return 0;
+}
